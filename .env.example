# PostgreSQL / Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# NextAuth
AUTH_SECRET="replace-with-a-long-random-secret"

# Academy administration
# Optional break-glass/bootstrap admin. The email must belong to an authenticated Academy user.
# Once another ADMIN role exists in the database this can be removed.
ACADEMY_ADMIN_EMAIL=""

# Challenge Arena
# Base URL of a self-hosted Piston API, for example http://runner.internal:2000
CHALLENGE_RUNNER_URL=""
# Optional bearer token if your runner proxy requires authorization.
CHALLENGE_RUNNER_TOKEN=""
